# =============================================================================
# AI Video Threat Recognition - Environment Configuration
# Copy to .env and modify as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=1
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Database (PostgreSQL for production, SQLite for development)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=threat_recognition
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# SQLite (dev only)
SQLITE_PATH=./data/threat_recognition.db

# -----------------------------------------------------------------------------
# Redis (queue/cache)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Model (YOLO26)
# -----------------------------------------------------------------------------
MODEL_WEIGHTS_DIR=./models
MODEL_DETECTOR_NAME=yolo26n
MODEL_DETECTOR_CONFIDENCE=0.25
MODEL_DETECTOR_IOU=0.45
MODEL_TRACKER_TYPE=bytetrack
MODEL_INFERENCE_DEVICE=cpu
MODEL_INFERENCE_BATCH_SIZE=1
MODEL_INFERENCE_TARGET_FPS=5.0

# -----------------------------------------------------------------------------
# Video / Media
# -----------------------------------------------------------------------------
VIDEO_MEDIA_DIR=./media
VIDEO_EVIDENCE_DIR=./media/evidence
VIDEO_CLIP_PRE_SECONDS=5.0
VIDEO_CLIP_POST_SECONDS=5.0
VIDEO_CLIP_MAX_DURATION=30.0
VIDEO_FRAME_BUFFER_SIZE=150
VIDEO_RTSP_TIMEOUT=10
VIDEO_RTSP_RECONNECT_DELAY=2.0
VIDEO_RTSP_MAX_RECONNECT_DELAY=60.0

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./media
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_TLS=true
NOTIFY_FROM_EMAIL=
NOTIFY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Privacy
# -----------------------------------------------------------------------------
PRIVACY_ENABLE_PRIVACY_ZONES=true
PRIVACY_MASK_BEFORE_INFERENCE=false
PRIVACY_MASK_AFTER_INFERENCE=true
PRIVACY_BLUR_KERNEL_SIZE=51

# -----------------------------------------------------------------------------
# Retention
# -----------------------------------------------------------------------------
RETENTION_EVIDENCE_DAYS=30
RETENTION_INCIDENTS_DAYS=365
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_CLEANUP_INTERVAL_HOURS=24